#include <zephyr/kernel.h>
#include <zephyr/device.h>
#include <zephyr/drivers/sensor.h>
#include <zephyr/drivers/gpio.h>

#include <zephyr/bluetooth/bluetooth.h>
#include <zephyr/bluetooth/conn.h>
#include <zephyr/bluetooth/gatt.h>
#include <bluetooth/services/nus.h>

#include <stdio.h>
#include <stdbool.h>
#include <math.h>


/* ============================================================
   LED SETTINGS
   ============================================================ */

#define BLUE_LED 6
#define GREEN_LED 30

static const struct device *gpio =
    DEVICE_DT_GET(DT_NODELABEL(gpio0));


/* ============================================================
   BLUETOOTH CONNECTION
   ============================================================ */

static bool connected = false;
static struct bt_conn *current_conn = NULL;


/* ============================================================
   BLUETOOTH ADVERTISING DATA
   ============================================================ */

static const struct bt_data ad[] = {

    BT_DATA_BYTES(
        BT_DATA_FLAGS,
        BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR
    ),
};


static const struct bt_data sd[] = {

    BT_DATA(
        BT_DATA_NAME_COMPLETE,
        CONFIG_BT_DEVICE_NAME,
        sizeof(CONFIG_BT_DEVICE_NAME) - 1
    ),
};


/* ============================================================
   LED FUNCTIONS
   ============================================================ */

static void blue_on(void)
{
    gpio_pin_set(gpio, BLUE_LED, 0);
}


static void blue_off(void)
{
    gpio_pin_set(gpio, BLUE_LED, 1);
}


static void green_on(void)
{
    gpio_pin_set(gpio, GREEN_LED, 0);
}


static void green_off(void)
{
    gpio_pin_set(gpio, GREEN_LED, 1);
}


/* ============================================================
   SEND DATA OVER BLUETOOTH

   Breaks the message into pieces that fit inside the
   currently available BLE MTU.
   ============================================================ */

static int send_data(
    struct bt_conn *conn,
    const uint8_t *data,
    uint16_t length)
{
    uint16_t mtu = bt_gatt_get_mtu(conn);

    /*
     * ATT uses 3 bytes of the MTU for its own header.
     */
    uint16_t packet_size = mtu - 3;

    uint16_t sent = 0;


    while (sent < length)
    {
        uint16_t size = length - sent;

        if (size > packet_size)
        {
            size = packet_size;
        }


        int err = bt_nus_send(
            conn,
            &data[sent],
            size
        );


        if (err)
        {
            return err;
        }


        sent += size;
    }


    return 0;
}


/* ============================================================
   BLUETOOTH CONNECTION CALLBACKS
   ============================================================ */

static void phone_connected(
    struct bt_conn *conn,
    uint8_t err)
{
    if (err)
    {
        return;
    }


    /*
     * Store the active BLE connection so that the
     * measurement loop can send data to it.
     */
    current_conn = bt_conn_ref(conn);

    connected = true;


    blue_off();
    green_on();


    printk("Device connected\n");
}


static void phone_disconnected(
    struct bt_conn *conn,
    uint8_t reason)
{
    connected = false;


    green_off();


    /*
     * Release our reference to the Bluetooth connection.
     */
    if (current_conn != NULL)
    {
        bt_conn_unref(current_conn);
        current_conn = NULL;
    }


    printk("Device disconnected\n");
}


/* Register Bluetooth connection callbacks */

BT_CONN_CB_DEFINE(connection_callbacks) = {

    .connected = phone_connected,

    .disconnected = phone_disconnected,
};


/* ============================================================
   NORDIC UART RECEIVE CALLBACK

   We keep this from your working Bluetooth program.

   If the computer sends something to the XIAO,
   the XIAO sends the same message back.
   ============================================================ */

static void received(
    struct bt_conn *conn,
    const uint8_t *const data,
    uint16_t len)
{
    printk("Received: ");

    for (int i = 0; i < len; i++)
    {
        printk("%c", data[i]);
    }

    printk("\n");


    send_data(
        conn,
        data,
        len
    );
}


static struct bt_nus_cb nus_callbacks = {

    .received = received,
};


/* ============================================================
   MAIN
   ============================================================ */

int main(void)
{
    int err;


    /* ========================================================
       GPIO / LEDs
       ======================================================== */

    if (!device_is_ready(gpio))
    {
        printk("GPIO not ready.\n");
        return 0;
    }


    gpio_pin_configure(
        gpio,
        BLUE_LED,
        GPIO_OUTPUT_HIGH
    );


    gpio_pin_configure(
        gpio,
        GREEN_LED,
        GPIO_OUTPUT_HIGH
    );


    blue_off();
    green_off();


    /* ========================================================
       GET LSM6DSL IMU
       ======================================================== */

    const struct device *imu =
        DEVICE_DT_GET_ONE(st_lsm6dsl);


    if (!device_is_ready(imu))
    {
        printk("LSM6DSL is not ready.\n");
        return 0;
    }


    printk("LSM6DSL ready.\n");


    /* ========================================================
       ACCELEROMETER RANGE = +/-16 g
       ======================================================== */

    struct sensor_value accel_range;


    sensor_g_to_ms2(
        16,
        &accel_range
    );


    if (sensor_attr_set(
            imu,
            SENSOR_CHAN_ACCEL_XYZ,
            SENSOR_ATTR_FULL_SCALE,
            &accel_range) < 0)
    {
        printk("Could not set accelerometer to +/-16 g.\n");
        return 0;
    }


    /* ========================================================
       ACCELEROMETER FREQUENCY = 104 Hz
       ======================================================== */

    struct sensor_value accel_frequency;


    accel_frequency.val1 = 104;
    accel_frequency.val2 = 0;


    if (sensor_attr_set(
            imu,
            SENSOR_CHAN_ACCEL_XYZ,
            SENSOR_ATTR_SAMPLING_FREQUENCY,
            &accel_frequency) < 0)
    {
        printk("Could not set accelerometer frequency.\n");
        return 0;
    }


    /* ========================================================
       GYROSCOPE FREQUENCY = 104 Hz
       ======================================================== */

    struct sensor_value gyro_frequency;


    gyro_frequency.val1 = 104;
    gyro_frequency.val2 = 0;


    if (sensor_attr_set(
            imu,
            SENSOR_CHAN_GYRO_XYZ,
            SENSOR_ATTR_SAMPLING_FREQUENCY,
            &gyro_frequency) < 0)
    {
        printk("Could not set gyroscope frequency.\n");
        return 0;
    }


    printk("Accelerometer: +/-16 g\n");
    printk("Sampling frequency: 104 Hz\n");


    /* ========================================================
       START BLUETOOTH
       ======================================================== */

    err = bt_enable(NULL);


    if (err)
    {
        printk("Bluetooth error: %d\n", err);
        return 0;
    }


    printk("Bluetooth ready.\n");


    /* ========================================================
       START NORDIC UART SERVICE
       ======================================================== */

    err = bt_nus_init(
        &nus_callbacks
    );


    if (err)
    {
        printk("NUS error: %d\n", err);
        return 0;
    }


    /* ========================================================
       START ADVERTISING
       ======================================================== */

err = bt_le_adv_start(
    BT_LE_ADV_CONN_FAST_1,
    ad,
    ARRAY_SIZE(ad),
    sd,
    ARRAY_SIZE(sd)
);

    if (err)
    {
        printk("Advertising error: %d\n", err);
        return 0;
    }


    printk("Advertising as ConcussionHeadband\n");
    printk("Starting measurements...\n");


    /* Original data header */

    printk(
        "time_ms;ax;ay;az;gx;gy;gz;a_total\n"
    );


    /* ========================================================
       VARIABLES FOR BLUE LED BLINK
       ======================================================== */

    uint32_t last_blink_time = 0;

    bool blue_state = false;


    /* ========================================================
       MAIN MEASUREMENT LOOP
       ======================================================== */

    while (1)
    {
        struct sensor_value ax_value;
        struct sensor_value ay_value;
        struct sensor_value az_value;

        struct sensor_value gx_value;
        struct sensor_value gy_value;
        struct sensor_value gz_value;


        /* ====================================================
           READ IMU
           ==================================================== */

        if (sensor_sample_fetch(imu) < 0)
        {
            printk("Sensor read error.\n");

            k_sleep(K_MSEC(10));

            continue;
        }


        /* Accelerometer */

        sensor_channel_get(
            imu,
            SENSOR_CHAN_ACCEL_X,
            &ax_value
        );


        sensor_channel_get(
            imu,
            SENSOR_CHAN_ACCEL_Y,
            &ay_value
        );


        sensor_channel_get(
            imu,
            SENSOR_CHAN_ACCEL_Z,
            &az_value
        );


        /* Gyroscope */

        sensor_channel_get(
            imu,
            SENSOR_CHAN_GYRO_X,
            &gx_value
        );


        sensor_channel_get(
            imu,
            SENSOR_CHAN_GYRO_Y,
            &gy_value
        );


        sensor_channel_get(
            imu,
            SENSOR_CHAN_GYRO_Z,
            &gz_value
        );


        /* ====================================================
           CONVERT VALUES TO DOUBLE
           ==================================================== */

        double ax =
            sensor_value_to_double(&ax_value);

        double ay =
            sensor_value_to_double(&ay_value);

        double az =
            sensor_value_to_double(&az_value);


        double gx =
            sensor_value_to_double(&gx_value);

        double gy =
            sensor_value_to_double(&gy_value);

        double gz =
            sensor_value_to_double(&gz_value);


        /* ====================================================
           TOTAL ACCELERATION
           ==================================================== */

        double a_total =
            sqrt(
                ax * ax +
                ay * ay +
                az * az
            );


        /* XIAO uptime */

        uint32_t time_ms =
            k_uptime_get_32();


        /* ====================================================
           CREATE DATA LINE
           ==================================================== */

        char tx_buffer[256];


        int tx_length = snprintf(
            tx_buffer,
            sizeof(tx_buffer),

            "%u;%f;%f;%f;%f;%f;%f;%f\n",

            time_ms,

            ax,
            ay,
            az,

            gx,
            gy,
            gz,

            a_total
        );


        /* ====================================================
           USB OUTPUT

           We deliberately keep this for now.

           This lets us compare USB and Bluetooth data while
           developing the wireless version.
           ==================================================== */

        printf(
            "%s",
            tx_buffer
        );


        /* ====================================================
           BLUETOOTH OUTPUT
           ==================================================== */

        if (
            connected &&
            current_conn != NULL &&
            tx_length > 0 &&
            tx_length < sizeof(tx_buffer)
        )
        {
            send_data(
                current_conn,
                (const uint8_t *)tx_buffer,
                (uint16_t)tx_length
            );
        }


        /* ====================================================
           LED CONTROL
           ==================================================== */

        if (!connected)
        {
            green_off();


            /*
             * Blink blue every 500 ms WITHOUT stopping
             * the measurement loop.
             *
             * This replaces the old 500 ms k_sleep() method.
             */

            if ((time_ms - last_blink_time) >= 500)
            {
                last_blink_time = time_ms;

                blue_state = !blue_state;


                if (blue_state)
                {
                    blue_on();
                }
                else
                {
                    blue_off();
                }
            }
        }
        else
        {
            blue_off();
            green_on();
        }


        /* ====================================================
           APPROXIMATELY 100 MEASUREMENTS / SECOND

           LSM6DSL configured internally for 104 Hz.
           ==================================================== */

        k_sleep(K_MSEC(10));
    }


    return 0;
}
