#include <stdio.h>
#include <math.h>

int main(void)
{
    double x = 0;
    double y = 0;

    FILE *fp = NULL;
    FILE *gnupipe = NULL;

    char *GnuCommands[] = {
        "set title \"Sine Wave Demo\"",
        "set xlabel \"x (radians)\"",
        "set ylabel \"sin(x)\"",
        "plot 'data.tmp' with lines"
    };

    // Create the data file
    fp = fopen("data.tmp", "w");

    if (fp == NULL)
    {
        printf("Could not open data.tmp\n");
        return 1;
    }

    // Generate points for the sine wave
    for (int i = 0; i <= 100; i++)
    {
        x = i * 0.1;
        y = sin(x);

        fprintf(fp, "%f %f\n", x, y);
    }

    // Make sure all data is written before Gnuplot reads it
    fclose(fp);

    // Start Gnuplot
    gnupipe = popen("gnuplot -persistent", "w");

    if (gnupipe == NULL)
    {
        printf("Could not open Gnuplot\n");
        return 1;
    }

    // Send commands to Gnuplot
    for (int i = 0; i < 4; i++)
    {
        fprintf(gnupipe, "%s\n", GnuCommands[i]);
    }

    pclose(gnupipe);

    return 0;
}
