CONFIG_NCS_SAMPLES_DEFAULTS=y

# ============================================================
# Serial / console
# ============================================================

CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_PRINTK=y

# printf floating-point support
CONFIG_CBPRINTF_FP_SUPPORT=y

# ============================================================
# Sensor subsystem
# ============================================================

CONFIG_SENSOR=y

# LSM6DSL IMU
CONFIG_LSM6DSL=y

# Floating point
CONFIG_FPU=y

# ============================================================
# Bluetooth
# ============================================================

CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="ConcussionHeadband"
CONFIG_BT_MAX_CONN=1

# Nordic UART Service
CONFIG_BT_NUS=y

# Larger BLE packets
CONFIG_BT_L2CAP_TX_MTU=247
CONFIG_BT_BUF_ACL_RX_SIZE=251

# ============================================================
# GPIO / LEDs
# ============================================================

CONFIG_GPIO=y
